{
  "name": "pin-and-hide",
  "displayName": "Pin & Hide",
  "description": "Visual Studio-style pin/unpin auto-hide for the Side Bar, Panel and Secondary Side Bar — reclaim your editor space.",
  "version": "0.1.1",
  "publisher": "mrashutoshnigam",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pin",
    "auto-hide",
    "sidebar",
    "panel",
    "layout"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "autoHide.choosePinned",
        "title": "Choose Pinned Parts…",
        "category": "Pin & Hide"
      },
      {
        "command": "autoHide.toggleSidebar",
        "title": "Toggle Pin: Primary Side Bar",
        "category": "Pin & Hide"
      },
      {
        "command": "autoHide.togglePanel",
        "title": "Toggle Pin: Panel",
        "category": "Pin & Hide"
      },
      {
        "command": "autoHide.toggleAux",
        "title": "Toggle Pin: Secondary Side Bar",
        "category": "Pin & Hide"
      },
      {
        "command": "autoHide.unpinSidebar",
        "title": "Unpin Primary Side Bar",
        "category": "Pin & Hide",
        "icon": "$(pinned)"
      },
      {
        "command": "autoHide.pinSidebar",
        "title": "Pin Primary Side Bar",
        "category": "Pin & Hide",
        "icon": "$(pin)"
      },
      {
        "command": "autoHide.unpinPanel",
        "title": "Unpin Panel",
        "category": "Pin & Hide",
        "icon": "$(pinned)"
      },
      {
        "command": "autoHide.pinPanel",
        "title": "Pin Panel",
        "category": "Pin & Hide",
        "icon": "$(pin)"
      },
      {
        "command": "autoHide.unpinAux",
        "title": "Unpin Secondary Side Bar",
        "category": "Pin & Hide",
        "icon": "$(pinned)"
      },
      {
        "command": "autoHide.pinAux",
        "title": "Pin Secondary Side Bar",
        "category": "Pin & Hide",
        "icon": "$(pin)"
      }
    ],
    "configuration": {
      "title": "Pin & Hide",
      "properties": {
        "autoHide.delay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Milliseconds to wait after the first editor click/keystroke/scroll before hiding unpinned parts."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "autoHide.unpinSidebar",
          "when": "viewLocation == sidebar && autoHide.sidebarPinned",
          "group": "navigation@100"
        },
        {
          "command": "autoHide.pinSidebar",
          "when": "viewLocation == sidebar && !autoHide.sidebarPinned",
          "group": "navigation@100"
        },
        {
          "command": "autoHide.unpinPanel",
          "when": "viewLocation == panel && autoHide.panelPinned",
          "group": "navigation@100"
        },
        {
          "command": "autoHide.pinPanel",
          "when": "viewLocation == panel && !autoHide.panelPinned",
          "group": "navigation@100"
        },
        {
          "command": "autoHide.unpinAux",
          "when": "viewLocation == auxiliarybar && autoHide.auxPinned",
          "group": "navigation@100"
        },
        {
          "command": "autoHide.pinAux",
          "when": "viewLocation == auxiliarybar && !autoHide.auxPinned",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "autoHide.unpinSidebar",
          "when": "false"
        },
        {
          "command": "autoHide.pinSidebar",
          "when": "false"
        },
        {
          "command": "autoHide.unpinPanel",
          "when": "false"
        },
        {
          "command": "autoHide.pinPanel",
          "when": "false"
        },
        {
          "command": "autoHide.unpinAux",
          "when": "false"
        },
        {
          "command": "autoHide.pinAux",
          "when": "false"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrashutoshnigam/pin-and-hide.git"
  },
  "bugs": {
    "url": "https://github.com/mrashutoshnigam/pin-and-hide/issues"
  },
  "homepage": "https://github.com/mrashutoshnigam/pin-and-hide#readme",
  "icon": "images/icon.png"
}
